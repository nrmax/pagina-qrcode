# ---------------------------------------------------------------
# NRmax · variáveis de ambiente (copie para .env.local)
#   cp .env.example .env.local
# NUNCA commitar o arquivo .env.local — ele está no .gitignore.
# ---------------------------------------------------------------

# Senha do administrador: 6 dígitos que VOCÊ escolher.
# Troque o valor abaixo no seu .env.local — este exemplo é propositalmente
# inválido para que ninguém consiga logar copiando o arquivo como está.
ADMIN_SENHA=TROQUE_POR_SENHA_DE_6_DIGITOS

# Segredo usado para assinar o cookie de sessão (texto longo e aleatório).
# Gere um novo para cada ambiente, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES

# ---------------------------------------------------------------
# Supabase (Project Settings -> API)
# A chave pública é segura para o frontend: ela é limitada pelas
# políticas RLS do banco (somente leitura do conteúdo público).
# NUNCA use a chave secret/service_role aqui nem no código.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICA
